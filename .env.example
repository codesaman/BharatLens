# BharatLens ML Configuration
# Optional: Government of India Open Data Portal (data.gov.in) API key
# If not provided, the pipeline gracefully relies on cached open datasets
DATA_GOV_IN_API_KEY=

# Pipeline and Cache settings
CACHE_DIR=data/raw
PROCESSED_DIR=data/processed
MODELS_DIR=models/saved
LOG_LEVEL=INFO

# Streamlit App Configuration
STREAMLIT_THEME_BASE=dark
STREAMLIT_SERVER_PORT=8501
